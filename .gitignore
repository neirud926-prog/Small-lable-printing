# VBA Project
Vba Project/

# Dependencies
node_modules/

# Build output (regenerated by `npm run build`, Tauri bundles its own)
dist/

# Tauri build artefacts — LARGE (~4.5 GB), never commit
src-tauri/target/
src-tauri/gen/schemas/

# Tauri binaries everywhere EXCEPT the release folder
*.exe
*.msi
*.app
!release/*.exe
!release/*.msi

# Local data / backups (machine-specific) — except the bundled seed shipped in src/assets
small-label-backup.json
!src/assets/small-label-backup.json
LABEL OUTPUT RESULT/

# Environment files
.env
.env.local

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Claude runtime lock (not source)
.claude/scheduled_tasks.lock
